    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "marked": "^14.1.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
