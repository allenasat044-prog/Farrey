{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farrey",
  "version": "0.4.0",
  "identifier": "com.farrey.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Farrey contributors",
    "copyright": "Copyright (c) 2026 Farrey contributors",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Sticky notes backed by Markdown files",
    "longDescription": "Farrey is a Stickies-style desktop note where every sticker is a live Markdown file. Open a README, tick checkboxes, edit in place, and keep your notes on top of your desktop.",
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/allenasat044-prog/Farrey/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCQjZGRjA5RjFCRjQ0MkMKUldRc1JML3hDZisyQzVPdk5zRmZpTjBQdXVXMHRJQ0FUVmppL0w0WUROckE5Q0ZHLzZUeVhJQksK"
    }
  }
}
